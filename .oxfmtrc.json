{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": false,
    "singleQuote": true,
    "printWidth": 80,
    "sortPackageJson": false,
    "ignorePatterns": [
        "api-specs/ledger-api",
        "**/routeTree.gen.ts",
        "core/ledger-client-types/src/generated-clients",
        "docs/**/*.mdx",
        "core/tx-clear-signing/examples/descriptors/ping.json",
        "core/tx-clear-signing/examples/descriptors/schema",
        "core/tx-clear-signing/examples/descriptors/invalid",
        "core/tx-clear-signing/examples/descriptors/splice"
    ]
}
