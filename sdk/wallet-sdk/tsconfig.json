{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "types": ["node"],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src/**/*"],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/__test__/**"
    ]
}
