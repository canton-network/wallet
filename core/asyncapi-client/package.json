{
    "name": "@canton-network/core-asyncapi-client",
    "version": "1.12.2",
    "type": "module",
    "description": "Provides a TypeScript asyncapi ledger client, generated by the OpenAPI spec",
    "license": "Apache-2.0",
    "author": "Phillip Olesen <phillip.olesen@digitalasset.com>",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown --onSuccess \"tsc\"",
        "dev": "tsdown --watch --onSuccess \"tsc\"",
        "clean": "tsc -b --clean; rm -rf dist",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\"",
        "test": "vitest run --project node --project browser --passWithNoTests",
        "test:coverage": "vitest run --project node --project browser --coverage --passWithNoTests"
    },
    "devDependencies": {
        "@types/node": "^25.9.4",
        "@vitest/browser-playwright": "^5.0.1",
        "@vitest/coverage-v8": "^5.0.1",
        "openapi-typescript": "^7.13.0",
        "playwright": "^1.61.1",
        "tsdown": "^0.23.0",
        "typescript": "^6.0.3",
        "vitest": "^5.0.1"
    },
    "dependencies": {
        "@canton-network/core-ledger-client-types": "workspace:^",
        "@canton-network/core-types": "workspace:^",
        "@canton-network/core-wallet-auth": "workspace:^",
        "bignumber.js": "^10.0.2",
        "pino": "^10.3.1"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/asyncapi-client"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/asyncapi-client#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
