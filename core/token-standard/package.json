{
    "name": "@canton-network/core-token-standard",
    "version": "1.19.0",
    "description": "daml codegen js for core token standard",
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/token-standard#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    },
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/token-standard"
    },
    "files": [
        "dist/**"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\"",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@canton-network/core-types": "workspace:",
        "@canton-network/core-wallet-auth": "workspace:",
        "@daml/types": "catalog:",
        "@mojotech/json-type-validation": "catalog:",
        "openapi-fetch": "catalog:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "rolldown": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:"
    },
    "nx": {
        "targets": {
            "typecheck": {
                "dependsOn": [
                    "^typecheck",
                    "dist-types"
                ]
            },
            "build": {
                "inputs": [
                    "production",
                    "^production",
                    "{workspaceRoot}/scripts/src/lib/version-config.json",
                    "{workspaceRoot}/scripts/src/lib/daml-codegen.ts",
                    "{workspaceRoot}/scripts/src/generate-token-standard.ts"
                ]
            },
            "dist-types": {
                "executor": "nx:noop",
                "dependsOn": [
                    "build"
                ]
            }
        }
    }
}
