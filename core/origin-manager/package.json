{
    "name": "@canton-network/core-origin-manager",
    "version": "1.3.1",
    "type": "module",
    "description": "Secure cross-window origin handshake and guarded postMessage helpers.",
    "license": "Apache-2.0",
    "author": "Mateusz Piątkowski <mateusz.piatkowski@digitalasset.com>",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            },
            "default": "./dist/index.js"
        }
    },
    "dependencies": {
        "tsdown": "^0.23.0",
        "tsx": "^4.23.1",
        "zod": "^4.4.3"
    },
    "scripts": {
        "test": "vitest run --project node --project browser",
        "test:coverage": "vitest run --project node --project browser --coverage",
        "build": "vite build",
        "clean": "tsc -b --clean; rm -rf dist",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\""
    },
    "devDependencies": {
        "@vitest/browser-playwright": "^5.0.1",
        "@vitest/coverage-v8": "^5.0.1",
        "typescript": "^6.0.3",
        "unplugin-dts": "^1.1.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.1"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/origin-manager"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/origin-manager#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
