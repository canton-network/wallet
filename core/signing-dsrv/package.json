{
    "name": "@canton-network/core-signing-dsrv",
    "version": "0.1.0",
    "type": "module",
    "description": "Wallet Gateway signing driver for the DSRV signing API",
    "license": "Apache-2.0",
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsdown --onSuccess \"tsc -p tsconfig.lib.json\"",
        "clean": "rm -rf dist"
    },
    "dependencies": {
        "@canton-network/core-signing-lib": "workspace:",
        "@canton-network/core-wallet-auth": "workspace:"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "catalog:",
        "tsdown": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "core/signing-dsrv"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/core/signing-dsrv#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    }
}
