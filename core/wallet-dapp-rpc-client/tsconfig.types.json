{
    "extends": "../../tsconfig.web.json",
    "compilerOptions": {
        "emitDeclarationOnly": true,
        "declaration": true,
        "declarationMap": true,
        "rootDir": "./src",
        "outDir": "./dist",
        "moduleResolution": "bundler",
        "noEmit": false,
        "composite": false,
        "types": ["isomorphic-fetch", "json-schema", "lodash", "ws"]
    },
    "files": ["src/index.ts"],
    "exclude": ["**/*.test.*", "**/*.spec.*", "**/__tests__/**"]
}
