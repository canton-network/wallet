{
    "name": "@canton-network/core-wallet-test-utils",
    "private": true,
    "version": "1.17.0",
    "type": "module",
    "description": "Utilities for writing (E2E) tests for the wallet gateway",
    "sideEffects": false,
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "@canton-network/source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        },
        "./localnet": {
            "@canton-network/source": "./src/localnet.ts",
            "types": "./dist/localnet.d.ts",
            "import": "./dist/localnet.js",
            "require": "./dist/localnet.cjs",
            "default": "./dist/localnet.js"
        }
    },
    "dependencies": {
        "@canton-network/core-ledger-client": "workspace:",
        "@canton-network/core-rpc-errors": "workspace:",
        "@canton-network/core-rpc-transport": "workspace:",
        "@canton-network/core-types": "workspace:",
        "@canton-network/core-wallet-auth": "workspace:",
        "@canton-network/core-wallet-user-rpc-client": "workspace:",
        "@canton-network/wallet-sdk": "workspace:^",
        "@logtape/logtape": "catalog:",
        "@logtape/testing": "catalog:",
        "@playwright/test": "catalog:",
        "tweetnacl": "catalog:",
        "tweetnacl-util": "catalog:"
    },
    "devDependencies": {
        "tsdown": "catalog:",
        "typescript": "catalog:"
    },
    "scripts": {
        "build": "tsdown --onSuccess \"tsc -p tsconfig.publish.json\"",
        "clean": "rm -rf dist",
        "flatpack": "pnpm pack --pack-destination \"$FLATPACK_OUTDIR\""
    },
    "files": [
        "dist/**"
    ]
}
