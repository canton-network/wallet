{
    "extends": "../../tsconfig.web.json",
    "compilerOptions": {
        "rootDir": "./src",
        "jsx": "react-jsx",
        "types": ["node"],
        "outDir": "./dist",
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "rewriteRelativeImportExtensions": true,
        "resolveJsonModule": true
    },
    "include": ["src"]
}
