{
    "name": "@canton-network/tool-conformance-cli",
    "version": "1.0.0",
    "type": "module",
    "description": "CLI and Playwright harness for the CIP-103 conformance dApp",
    "license": "Apache-2.0",
    "author": "Pascal Honegger <pascal.honegger@digitalasset.com>",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "conformance-cli": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "vite build && tsc",
        "typecheck": "tsc --noEmit --emitDeclarationOnly false",
        "test": "pnpm run build && vitest run --project node",
        "clean": "tsc -b --clean; rm -rf dist",
        "run": "node src/cli.ts"
    },
    "dependencies": {
        "@canton-network/tool-conformance-dapp": "catalog:",
        "commander": "catalog:",
        "ctrf": "catalog:",
        "express": "catalog:",
        "playwright": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@canton-network/core-eslint-config": "catalog:",
        "@canton-network/core-wallet-dapp-rpc-client": "catalog:",
        "@types/express": "catalog:",
        "@types/node": "catalog:",
        "eslint": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/canton-network/wallet.git",
        "directory": "tools/conformance-cli"
    },
    "homepage": "https://github.com/canton-network/wallet/tree/main/tools/conformance-cli#readme",
    "bugs": {
        "url": "https://github.com/canton-network/wallet/issues"
    },
    "nx": {
        "targets": {
            "run": {
                "dependsOn": [
                    "^build"
                ]
            }
        }
    }
}
