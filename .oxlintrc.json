{
    "$schema": "./node_modules/oxlint/configuration_schema.json",
    "plugins": ["unicorn", "typescript", "oxc", "import"],
    "options": {
        "typeAware": true
    },
    "jsPlugins": [
        {
            "name": "header",
            "specifier": "@tony.ganchev/eslint-plugin-header"
        }
    ],
    "categories": {
        "correctness": "error",
        "suspicious": "error"
    },
    "ignorePatterns": [
        "**/_proto",
        "**/routeTree.gen.ts",
        "core/ledger-client-types/src/generated-clients",
        "core/rpc-generator/templates",
        "core/wallet-user-rpc-client",
        "core/wallet-dapp-rpc-client",
        "core/wallet-dapp-remote-rpc-client"
    ],
    "rules": {
        "header/header": [
            "error",
            "line",
            [
                {
                    "pattern": "^ Copyright \\(c\\) 2025-\\d{4} Digital Asset \\(Switzerland\\) GmbH and/or its affiliates\\. All rights reserved\\.$",
                    "template": " Copyright (c) 2025-2026 Digital Asset (Switzerland) GmbH and/or its affiliates. All rights reserved."
                },
                " SPDX-License-Identifier: Apache-2.0"
            ],
            2
        ],
        "typescript/consistent-type-imports": [
            "error",
            {
                "fixStyle": "inline-type-imports",
                "disallowTypeAnnotations": false
            }
        ],
        "import/extensions": [
            "error",
            "always",
            { "ignorePackages": true, "checkTypeImports": true, "js": "never" }
        ],
        "typescript/no-import-type-side-effects": "error",
        "typescript/no-explicit-any": "error",
        "typescript/unbound-method": "off",
        "typescript/consistent-return": "off",
        "typescript/no-extraneous-class": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-unnecessary-type-conversion": "off",
        "typescript/no-unnecessary-type-parameters": "off",
        "typescript/no-unsafe-enum-assignment": "off",
        "typescript/no-unsafe-enum-comparison": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "import/no-unassigned-import": "off",
        "no-new": "off",
        "no-shadow": "off",
        "no-useless-concat": "off",
        "no-underscore-dangle": "off",
        "unicorn/consistent-function-scoping": "off",
        "unicorn/no-array-sort": "off",
        "unicorn/prefer-add-event-listener": "off",
        "unicorn/require-post-message-target-origin": "off",
        "react/react-in-jsx-scope": "off"
    }
}
